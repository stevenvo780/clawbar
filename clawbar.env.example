# ===========================================================================
# clawbar.env — configuration for the clawbar voice bridge + waybar module.
#
# Copy this file to clawbar.env (next to the scripts, or to
# ~/.config/clawbar/clawbar.env) and edit. install.sh creates it for you if it
# does not exist yet.
#
# NO SECRETS LIVE HERE. The agent's gateway auth token, passwords, etc. stay in
# the container / your secret store — never in this file or this repo.
# Every value below is a generic default; override only what you need.
# ===========================================================================

# --- containers --------------------------------------------------------------
# Name of the OpenClaw agent container and the audio (Whisper STT + Kokoro TTS)
# sidecar container. The audio endpoint is resolved from the container's docker
# IP at runtime (no published port needed).
CLAW_CTR=claw
AUDIO_CTR=claw-audio
AUDIO_PORT=8000

# --- models / voice ----------------------------------------------------------
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX-fp16
STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
VOICE=ef_dora
LANG_STT=es

# --- agent -------------------------------------------------------------------
AGENT=main
SESSION=desktop-voice
THINKING=off          # off = fast/conversational; medium|high = more reasoning
AGENT_TIMEOUT=180

# --- microphone / recording --------------------------------------------------
MIC_TARGET=           # empty = default PipeWire source; else a source name
MAX_REC_SECS=60       # hard safety cap on a single recording
SPEAK_MAXCHARS=1400   # truncate very long replies before TTS

# --- VAD (Voice Activity Detection — auto-stop on silence) -------------------
CLAWBAR_VAD=on        # on|off — when on, recording auto-stops after silence
VAD_SILENCE_MS=1500   # trailing silence (ms) required to auto-stop
VAD_THRESH_DB=-38     # RMS dBFS above which a 30ms frame counts as speech
VAD_MIN_SPEECH_MS=300 # min cumulative speech before the silence cutoff arms
VAD_START_GRACE_MS=8000 # give up waiting for speech to start after this long

# --- waybar ------------------------------------------------------------------
# Real-time icon updates: claw-talk runs `pkill -RTMIN+<N> waybar` on each state
# change. This N MUST match "signal" in the waybar module (default 8).
CLAWBAR_WAYBAR_SIGNAL=8
# Where the current phase is written (read by clawbar-status). Default is fine.
# CLAWBAR_STATE_FILE=/run/user/1000/clawbar.state

# --- screen capture (vision on demand) ---------------------------------------
SHOT_MODE=-m          # -m current monitor | -f whole desktop | -a active window
SHOT_MAXPX=1568       # downscale long edge before sending to the agent
SHOT_HOSTDIR=/datos/claw-config/clawd/_voice
SHOT_AGENTREL=_voice/screen.png
